{
  "name": "northpoint",
  "productName": "NORTHPOINT",
  "version": "1.0.5",
  "description": "NORTHPOINT · del examen al payout",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "node sync-web.js && electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.northpoint.journal",
    "productName": "NORTHPOINT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "NORTHPOINT-${version}-${arch}.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NORTHPOINT",
      "artifactName": "NORTHPOINT-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NORTHPOINT-Portable-${version}.${ext}"
    }
  },
  "author": "André Macouzet"
}